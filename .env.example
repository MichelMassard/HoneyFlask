# Copia questo file in ".env" e compila i valori. Il file ".env" NON va su git.

# Chiave segreta di Flask (sessioni e cookie). Genera una stringa lunga e casuale:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiami

# Database. Se non lo imposti, usa SQLite (instance/honeypot.db)
DATABASE_URL=sqlite:///honeypot.db

# Dice al comando "flask" dove si trova l'app
FLASK_APP=wsgi.py
